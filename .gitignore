# Unity3D 项目 Git 忽略文件
# 参考：https://github.com/github/gitignore/blob/main/Unity.gitignore

# ----- Unity 编辑器与运行时产物 -----
# 导入资源、元数据、缓存（可重新生成）
/[Ll]ibrary/
# 编辑器临时目录
/[Tt]emp/
# Mono / C# 编译中间产物（含 Packages 子项目里的 obj/）
**/[Oo]bj/
# 构建输出
/[Bb]uild/
# 构建输出（复数）
/[Bb]uilds/
# Unity 打包产物
/[Bb]undles/
# 编辑器与运行时日志
/[Ll]ogs/
# 用户特定的编辑器偏好
/[Uu]ser[Ss]ettings/
*.log
# 内存快照（可能含敏感数据）
/[Mm]emoryCaptures/
# 录制数据
/[Rr]ecordings/

# ----- Unity 资源相关 -----
# Blender 备份文件
*.blend1
*.blend1.meta
# /[Aa]ssets/AssetStoreTools*   # Asset Store Tools（按需启用）
# JetBrains Rider 插件
/[Aa]ssets/Plugins/Editor/JetBrains*
# Rider 个人层设置
*.DotSettings.user
# Play Mode 测试场景
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ----- Addressables / StreamingAssets -----
/ServerData
/[Aa]ssets/StreamingAssets/aa*
# YooAsset 构建输出 (AssetBundle 产物)
/[Aa]ssets/StreamingAssets/Bundles*
# 代码包产物 (热更 dll / AOT 补充元数据 dll，由菜单 Compile 与 HybridCLR CopyAotDlls 生成)
/[Pp]ackages/cn.rendu.loader/Bundles/Code/*
/[Pp]ackages/cn.rendu.loader/Bundles/AotDlls/*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ----- Visual Scripting 自动生成 -----
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ----- IDE 与缓存目录 -----
# Visual Studio 缓存
.vs/
# Gradle 缓存
.gradle/
# JetBrains IDE
.idea/

# ----- 自动生成的项目 / 解决方案文件 -----
ExportedObj/
.consulo/
# C# 项目文件
*.csproj
*.unityproj
# Visual Studio 解决方案
*.sln
# VS 用户选项
*.suo
*.tmp
*.user
*.userprefs
# MonoDevelop 项目数据库
*.pidb
# UnityBoo 项目文件
*.booproj
# 调试信息
*.svd
# 程序数据库
*.pdb
# Mono 调试数据库
*.mdb
*.opendb
*.VC.db

# ----- 调试与符号元数据 -----
*.pidb.meta
*.pdb.meta
*.mdb.meta
# 崩溃时生成的系统信息
sysinfo.txt
# Mono 崩溃转储
mono_crash.*

# ----- 构建产物（最终包） -----
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# ----- Crashlytics -----
crashlytics-build.properties

# ----- Rendu 项目特定 -----
# macOS 系统文件
.DS_Store
# CodeBuddy（AI 助手本地数据，不入库）
/.codebuddy/
# CodeBuddy / Unity 编辑器临时状态（端口、心跳、序列号）
.com-unity-codely.json
# 根目录 Bin/ 下的 .NET 构建产物（白名单保留 NLog.config 业务配置）
/Bin/*
# Packages/ 子项目编译产物（DotNet~/Tools~ 子项目下的 bin/、Bin/）
/Packages/**/[Bb]in/
# Packages 下 DotNet~ 子工程需要入库（工具/导出/源生成器工程）
!Packages/*/DotNet~/**/*.csproj
# HybridCLRData/ 工具链内 bin
/HybridCLRData/**/[Bb]in/
# HybridCLRData/ 整体忽略：本地 il2cpp 副本 + 裁剪/热更 dll，由 HybridCLR/Installer 重新生成（约 900MB）
/HybridCLRData/