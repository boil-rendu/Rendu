<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    editor-extension-mode="True"
>
    <ui:VisualElement name="container" style="padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;">
        <ui:Label name="titleLabel" text="Excel Manager" style="font-size: 18px; unity-font-style-and-weight: bold; margin-bottom: 5px;" />

        <ui:VisualElement name="statsBox" style="background-color: rgba(50, 50, 50, 0.5); padding: 10px; border-radius: 5px;">
            <ui:VisualElement name="statsRow" style="flex-direction: row; justify-content: space-between;">
                <ui:Label name="totalLabel" text="Total: 0" />
                <ui:Label name="statusLabel" text="Status: Normal" style="color: #4caf50;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="toolbarBox" style="background-color: rgba(50, 50, 50, 0.5); padding: 10px; border-radius: 5px;">
            <ui:VisualElement name="toolbarRow" style="flex-direction: row; justify-content: space-between;">
                <ui:Button name="refreshButton" text="Refresh" style="width: 80px;" />
                <ui:Button name="exportButton" text="Excel Export" style="height: 24px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="listBox" style="background-color: rgba(50, 50, 50, 0.5); padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;">
            <ui:VisualElement name="listHeader" style="flex-direction: row; background-color: rgba(100, 100, 100, 0.3); padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px;">
                <ui:Label text="文件名" style="width: 250px; unity-font-style-and-weight: bold;" />
                <ui:Label text="相对目录" style="width: 200px; unity-font-style-and-weight: bold;" />
                <ui:Label text="完整路径" style="unity-font-style-and-weight: bold;" />
            </ui:VisualElement>
            <ui:ScrollView name="scrollView">
                <ui:ListView name="excelListView" style="height: 300px;" />
            </ui:ScrollView>
            <ui:Label name="emptyLabel" text="No Excel files found, please ensure there is an Excel folder in the project" style="display: none; color: #2196f3; font-style: italic;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
