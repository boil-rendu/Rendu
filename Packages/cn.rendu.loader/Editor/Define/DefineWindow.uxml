<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="Container">
        <ui:Label name="TitleLabel" text="⚙️ Scripting Defines" style="unity-font-style: bold; font-size: 18px; margin-top: 10px;" />
        <ui:VisualElement name="HeaderLine" style="height: 2px; background-color: rgb(64, 141, 242); margin-bottom: 15px;" />
        
        <ui:VisualElement name="ContentBox" style="padding: 10px;">
            <ui:Label text="Current Scripting Defines:" style="unity-font-style: bold; margin-bottom: 5px;" />
            <ui:ScrollView name="DefinesScrollView" style="height: 60px; margin-bottom: 15px;" />
            
            <ui:Label text="Common Scripting Defines:" style="unity-font-style: bold; margin-bottom: 5px;" />
            <ui:Toggle name="INITEDToggle" text="INITED - Project Initialized" style="margin-bottom: 5px;" />
            <ui:Toggle name="CLIENTSERVERToggle" text="CLIENTSERVER - Client + Server Mode" style="margin-bottom: 5px;" />
            <ui:Toggle name="SERVERToggle" text="SERVER - Server Mode" style="margin-bottom: 5px;" />
            <ui:Toggle name="CLIENTToggle" text="CLIENT - Client Mode" style="margin-bottom: 5px;" />
            <ui:Toggle name="ENABLE_HOTFIXToggle" text="ENABLE_HOTFIX - Enable Hot Update" style="margin-bottom: 5px;" />
            <ui:Toggle name="ENABLE_HYBRIDCLRToggle" text="ENABLE_HYBRIDCLR - Enable HybridCLR" style="margin-bottom: 15px;" />
            
            <ui:Button name="SaveButton" text="💾 Save Configuration" style="height: 35px; background-color: rgb(77, 141, 242);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
