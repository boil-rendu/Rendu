<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="Container">
        <ui:Label name="TitleLabel" text="🏠 Project Initialization" style="unity-font-style: bold; font-size: 18px; margin-top: 10px;" />
        <ui:VisualElement name="HeaderLine" style="height: 2px; background-color: rgb(64, 141, 242); margin-bottom: 15px;" />
        
        <ui:ScrollView name="ScrollView">
            <ui:VisualElement name="ContentBox">
                <ui:Label name="InfoLabel" text="" style="margin-bottom: 20px;" />
                <ui:Button name="InitButton" text="🚀 Initialize Project" style="height: 45px; background-color: rgb(51, 179, 77); font-size: 14px; display: none;" />
                <ui:VisualElement name="ProjectInfoBox" style="padding: 10px; margin-top: 20px;">
                    <ui:Label text="📊 Project Information" style="unity-font-style: bold; margin-bottom: 5px;" />
                    <ui:Label name="PackageNameLabel" text="Package Name: " style="margin-bottom: 5px;" />
                    <ui:Label name="SceneNameLabel" text="Scene Name: " style="margin-bottom: 5px;" />
                    <ui:Label name="CodeModeLabel" text="Code Mode: " style="margin-bottom: 5px;" />
                    <ui:Label name="AddressLabel" text="Server Address: " style="margin-bottom: 5px;" />
                    <ui:Label name="StatusLabel" text="Status: " />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
