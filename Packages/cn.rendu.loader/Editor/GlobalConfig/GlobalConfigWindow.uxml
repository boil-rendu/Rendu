<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="Container">
        <ui:Label name="TitleLabel" text="⚙️ Global Config" style="unity-font-style: bold; font-size: 18px; margin-top: 10px;" />
        <ui:VisualElement name="HeaderLine" style="height: 2px; background-color: rgb(64, 141, 242); margin-bottom: 15px;" />
        
        <ui:VisualElement name="FieldsBox" style="padding: 10px;">
            <ui:Label text="Code Mode" style="unity-font-style: bold; margin-bottom: 5px;" />
            <ui:EnumField name="CodeModeField" label="" style="margin-bottom: 10px;" />
            
            <ui:Label text="Scene Name" style="unity-font-style: bold; margin-bottom: 5px;" />
            <ui:TextField name="SceneNameField" label="" style="margin-bottom: 10px;" />
            
            <ui:Label text="Address" style="unity-font-style: bold; margin-bottom: 5px;" />
            <ui:TextField name="AddressField" label="" style="margin-bottom: 20px;" />
        </ui:VisualElement>
        
        <ui:Button name="RegenerateButton" text="🔄 Regenerate Assembly References" style="height: 38px; background-color: rgb(77, 141, 242); font-size: 13px; margin-top: 20px;" />
    </ui:VisualElement>
</ui:UXML>
