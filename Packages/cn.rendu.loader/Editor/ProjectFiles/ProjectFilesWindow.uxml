<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="Container">
        <ui:Label name="TitleLabel" text="📁 Project File Management" style="unity-font-style: bold; font-size: 18px; margin-top: 10px;" />
        <ui:VisualElement name="HeaderLine" style="height: 2px; background-color: rgb(64, 141, 242); margin-bottom: 15px;" />
        
        <ui:ScrollView name="ScrollView">
            <ui:VisualElement name="ContentBox">
                <ui:VisualElement name="SlnBox" style="padding: 10px; margin-bottom: 15px;">
                    <ui:Label text="🔗 Solution Files" style="unity-font-style: bold; margin-bottom: 10px;" />
                    <ui:Label name="SlnStatusLabel" text="Sln Status: " style="margin-bottom: 10px;" />
                    <ui:Button name="LinkSlnButton" text="🔗 Link Sln File" style="height: 35px;" />
                </ui:VisualElement>
                
                <ui:VisualElement name="AssemblyBox" style="padding: 10px; margin-bottom: 15px;">
                    <ui:Label text="📦 Assembly" style="unity-font-style: bold; margin-bottom: 10px;" />
                    <ui:VisualElement name="AssemblyButtonsContainer" style="flex-direction: row;">
                        <ui:Button name="RegenerateProjectButton" text="Regenerate Project Files" style="height: 35px; flex-grow: 1; margin-right: 5px;" />
                        <ui:Button name="RefreshDatabaseButton" text="Refresh Asset Database" style="height: 35px; flex-grow: 1; margin-left: 5px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:VisualElement name="ReferencesBox" style="padding: 10px;">
                    <ui:Label text="📝 Script References" style="unity-font-style: bold; margin-bottom: 10px;" />
                    <ui:VisualElement name="ReferencesButtonsContainer" style="flex-direction: row; margin-bottom: 5px;">
                        <ui:Button name="GenerateReferencesButton" text="Generate Assembly References" style="height: 35px; flex-grow: 1; margin-right: 5px;" />
                        <ui:Button name="UpdateReferencesButton" text="Update Script References" style="height: 35px; flex-grow: 1; margin-left: 5px;" />
                    </ui:VisualElement>
                    <ui:Button name="RunInitScriptsButton" text="Run Initialization Scripts" style="height: 35px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
