<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="container" style="padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;">
        <ui:Label name="titleLabel" text="创建 Rendu Package" style="font-size: 18px; unity-font-style-and-weight: bold; margin-bottom: 5px;" />

        <ui:VisualElement name="forceUpdateBox" style="background-color: rgba(50, 50, 50, 0.5); padding: 10px; border-radius: 5px;">
            <ui:Toggle name="forceUpdateToggle" label="强制更新 (Force Update)" />
            <ui:VisualElement name="forceUpdateInfoBox" />
        </ui:VisualElement>

        <ui:VisualElement name="requiredBox" style="background-color: rgba(50, 50, 50, 0.5); padding: 10px; border-radius: 5px; margin-top: 10px;">
            <ui:VisualElement name="requiredHeader" style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label name="requiredLabel" text="必需属性 (Required)" style="unity-font-style-and-weight: bold;" />
                <ui:Button name="requiredFoldoutButton" text="▼" style="width: 30px;" />
            </ui:VisualElement>
            <ui:VisualElement name="requiredContent">
                <ui:TextField name="simpleNameField" label="Package Name" />
                <ui:TextField name="formalNameField" label="Formal Name" />
                <ui:TextField name="displayNameField" label="Display Name" />
                <ui:TextField name="versionField" label="Version" />
                <ui:TextField name="unityVersionField" label="Unity Version" />
                <ui:VisualElement name="asmDefTypeContainer" style="margin-top: 0px; margin-bottom: 0px;" />
                <ui:VisualElement name="asmRefTypeContainer" style="margin-top: 0px; margin-bottom: 0px;" />
                <ui:VisualElement name="codeModeContainer" style="margin-top: 0px; margin-bottom: 0px;" />
                <ui:Toggle name="ignoreAsmdefToggle" label="生成 Ignore Asmdef" />
                <ui:Label name="ignoreAsmdefHint" text="勾选后会在包根目录生成 Ignore.{PackageName}.asmdef 文件，该文件用于从Unity中排除特定项目" style="font-style: italic; color: #888; margin-left: 10px; margin-bottom: 10px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="optionalBox" style="background-color: rgba(50, 50, 50, 0.5); padding: 10px; border-radius: 5px; margin-top: 10px;">
            <ui:VisualElement name="optionalHeader" style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label name="optionalLabel" text="可选属性 (Optional)" style="unity-font-style-and-weight: bold;" />
                <ui:Button name="optionalFoldoutButton" text="▼" style="width: 30px;" />
            </ui:VisualElement>
            <ui:VisualElement name="optionalContent">
                <ui:TextField name="descriptionField" label="Description" />
                <ui:TextField name="authorNameField" label="Author Name" />
                <ui:TextField name="authorEmailField" label="Author Email" />
                <ui:TextField name="authorUrlField" label="Author URL" />
                <ui:TextField name="keywordsField" label="Keywords" />
                <ui:Label name="keywordsHint" text="用逗号分隔多个关键词" style="font-style: italic; color: #888; margin-left: 10px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="summaryBox" style="background-color: rgba(50, 50, 50, 0.5); padding: 10px; border-radius: 5px; margin-top: 10px;">
            <ui:Label name="summaryLabel" text="📋 摘要" style="unity-font-style-and-weight: bold; margin-bottom: 5px;" />
            <ui:Label name="summaryFormalName" text="" />
            <ui:Label name="summaryDisplayName" text="" />
            <ui:Label name="summaryVersion" text="" />
            <ui:Label name="summaryUnity" text="" />
            <ui:Label name="summaryDescription" text="" />
            <ui:Label name="summaryAsmDef" text="" />
            <ui:Label name="summaryAsmRef" text="" />
            <ui:Label name="summaryCodeMode" text="" />
            <ui:Label name="summaryIgnoreAsmdef" text="" />
            <ui:Label name="summaryAuthor" text="" />
            <ui:Label name="summaryAuthorEmail" text="" />
            <ui:Label name="summaryAuthorUrl" text="" />
            <ui:Label name="summaryKeywords" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="buttonBox" style="flex-direction: row; justify-content: flex-end; margin-top: 10px;">
            <ui:Button name="cancelButton" text="Cancel" style="width: 100px; margin-right: 10px;" />
            <ui:Button name="createButton" text="Create" style="width: 100px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
