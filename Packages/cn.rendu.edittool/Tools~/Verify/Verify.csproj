<Project Sdk="Microsoft.NET.Sdk">

  <!--
    包内自带的离线校验工程: 把本包 Editor / Tests 的源码, 连同其依赖 cn.rendu.panel
    的 Runtime / Editor 源码, 一起编进一个普通 .NET 进程, 在不开 Unity 的前提下跑 NUnit 用例
    (自带一个极简运行器, 见 Program.cs)。

    用法: 进入本目录后执行 dotnet run (csproj 就在当前目录, 无需指定工程文件)。

    需要 UnityEngine.dll / UnityEditor.dll 做引用, 默认指向 Tuanjie 安装目录。
    换机器/换 Unity 版本时用属性或环境变量指定(二选一):
        dotnet run -p:UnityManaged=/Applications/Unity/Hub/Editor/2022.3.62f1/Unity.app/Contents/Managed
        UNITY_MANAGED=/path/to/Managed dotnet run
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Verify</AssemblyName>
    <RootNamespace>Verify</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS0618</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 绘制层(UI Toolkit 后端)整段包在 #if UNITY_2021_2_OR_NEWER 里, 离线编译没有 Unity 的隐式宏:
         不补这一行, UitkDriver.cs 会被整段跳过, 这里校验到的就只剩 IMGUI 那条路 -->
    <DefineConstants>$(DefineConstants);UNITY_2021_2_OR_NEWER</DefineConstants>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <UnityManaged Condition="'$(UnityManaged)' == '' and '$(UNITY_MANAGED)' != ''">$(UNITY_MANAGED)</UnityManaged>
    <UnityManaged Condition="'$(UnityManaged)' == ''">/Applications/Tuanjie/Hub/Editor/2022.3.62t10/Tuanjie.app/Contents/Managed</UnityManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- 本包 -->
    <Compile Include="../../Editor/**/*.cs" />
    <Compile Include="../../Tests/Editor/*.cs" />
    <!-- 依赖: cn.rendu.panel 的全部源码(特性 + 绘制引擎) -->
    <Compile Include="../../../cn.rendu.panel/Runtime/*.cs" />
    <Compile Include="../../../cn.rendu.panel/Runtime/Attributes/*.cs" />
    <Compile Include="../../../cn.rendu.panel/Runtime/Utilities/*.cs" />
    <Compile Include="../../../cn.rendu.panel/Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManaged)/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEditor">
      <HintPath>$(UnityManaged)/UnityEditor.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
