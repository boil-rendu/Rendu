<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    editor-extension-mode="True"
>
    <ui:VisualElement name="container" style="padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;">
        <ui:VisualElement name="header" style="border-bottom: 2px solid rgb(63, 140, 242); padding-bottom: 8px; margin-bottom: 15px;">
            <ui:VisualElement name="headerRow" style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label name="titleLabel" text="🎯 Proto Manager" style="font-size: 20px; unity-font-style-and-weight: bold;" />
                <ui:Label name="versionLabel" text="v1.0" style="font-size: 11px; color: rgb(153, 153, 153);" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="tabBar" style="flex-direction: row; background-color: rgba(50, 50, 50, 0.5); padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px;">
            <ui:Button name="listTabButton" text="Proto List" />
            <ui:Button name="editTabButton" text="Proto Edit" />
        </ui:VisualElement>

        <ui:ScrollView name="contentScrollView">
            <ui:VisualElement name="tabContentContainer" style="padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
