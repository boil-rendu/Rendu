<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <RootNamespace>RD</RootNamespace>
        <LangVersion>12</LangVersion>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>DOTNET</DefineConstants>
        <OutputPath>$(SolutionDir)Bin</OutputPath>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Optimize>false</Optimize>
        <NoWarn>0169,0649,3021,8981,CS9193,CS9192,CS9074,NU1903</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>DOTNET</DefineConstants>
        <OutputPath>$(SolutionDir)Bin</OutputPath>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>0169,0649,3021,8981,CS9193,CS9192,CS9074,NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(SolutionDir)Packages/cn.rendu.*/Scripts/Core/Share/**/*.cs">
            <Link>%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="$(SolutionDir)Packages/cn.rendu.*/Scripts/Core/Server/**/*.cs">
            <Link>%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
        <ProjectReference Include="$(SolutionDir)Packages/cn.rendu.sourcegenerator/DotNet~/RD.SourceGenerator/RD.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="$(SolutionDir)Packages/cn.rendu.sourcegenerator/DotNet~/RD.SourceGeneratorAttribute/RD.SourceGeneratorAttribute.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <PackageReference Include="MemoryPack" Version="1.21.4" />
        <PackageReference Include="MongoDB.Driver" Version="3.11.2" />
        <PackageReference Include="NLog" Version="5.3.2" />
    </ItemGroup>
</Project>
